{
  "name": "gridhub",
  "version": "0.3.0",
  "description": "テスト1件が1マス。5mm方眼ノートのすごろくで開発を進める、ゲーム型の開発進行（旧名 マスメ。Linear/Jira に「状態」を持たせる）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/e2e/[ABDEMPQS]*.test.mjs tests/e2e/G[0-9]*.test.mjs",
    "test:goal": "node --test tests/e2e/GOAL16.test.mjs",
    "serve": "node bin/gridhub.js serve",
    "board": "node bin/gridhub.js serve",
    "mac": "sh mac/build.sh"
  },
  "license": "MIT"
}
