{
  "name": "masume",
  "version": "0.1.0",
  "description": "5mm方眼ノートのすごろくで開発を進める、ゲーム型タスク管理（Linear/Jiraに「状態」を持たせる）",
  "type": "module",
  "bin": {
    "masume": "bin/masume.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/e2e/[ABEMPQS]*.test.mjs tests/e2e/G[0-9]*.test.mjs",
    "test:goal": "node --test tests/e2e/GOAL10.test.mjs",
    "serve": "node bin/masume.js serve",
    "board": "node bin/masume.js serve"
  },
  "license": "MIT"
}
