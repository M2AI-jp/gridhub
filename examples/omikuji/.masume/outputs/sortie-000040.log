import { appendFile, mkdir, readFile } from 'node:fs/promises';
import { dirname, resolve } from 'node:path';

function historyPath() {
  return resolve(
    process.cwd(),
    process.env.OMIKUJI_HISTORY_FILE || '.omikuji-history.jsonl',
  );
}

async function readHistory(filePath) {
  try {
    return await readFile(filePath, 'utf8');
  } catch (error) {
    if (error.code === 'ENOENT') return '';
    throw error;
  }
}

async function listHistory() {
  const contents = await readHistory(historyPath());
  if (contents === '') return [];

  const lines = contents.split('\n');
  if (lines.at(-1) === '') lines.pop();
  return lines.map((line) => JSON.parse(line));
}

async function appendHistory() {
  process.stdin.setEncoding('utf8');
  let input = '';
  for await (const chunk of process.stdin) input += chunk;
  const draw = JSON.parse(input);

  const filePath = historyPath();
  const contents = await readHistory(filePath);
  const separator = contents !== '' && !contents.endsWith('\n') ? '\n' : '';
  await mkdir(dirname(filePath), { recursive: true });

  const record = {
    fortune: draw.fortune,
    advice: draw.advice,
    seed: draw.seed,
    drawnAt: new Date().toISOString(),
  };
  await appendFile(filePath, `${separator}${JSON.stringify(record)}\n`, 'utf8');
  return record;
}

if (process.argv[2] === 'list') {
  process.stdout.write(`${JSON.stringify(await listHistory())}\n`);
} else if (process.argv[2] === 'append') {
  process.stdout.write(`${JSON.stringify(await appendHistory())}\n`);
}

