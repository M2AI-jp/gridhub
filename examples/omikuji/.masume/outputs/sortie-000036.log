diff --git a/examples/omikuji/src/fortune/main.mjs b/examples/omikuji/src/fortune/main.mjs
index 7c54fe37b3380be34170f155324929692e8ca95c..b4d4751164d76ca58250a5ae720a5bf0869743cd
--- a/examples/omikuji/src/fortune/main.mjs
+++ b/examples/omikuji/src/fortune/main.mjs
@@ -1,4 +1,4 @@
-import { createHash } from 'node:crypto';
+import { createHash, randomInt } from 'node:crypto';
 
 const catalog = [
   { fortune: '大吉', advice: 'やってみたかったことに、一歩踏み出してみましょう。' },
@@ -9,11 +9,24 @@
   { fortune: '凶', advice: '無理をせずひと休みして、大切なことから確かめましょう。' },
 ];
 
-if (process.argv.length === 3 && process.argv[2] === '--catalog') {
+const args = process.argv.slice(2);
+
+if (args.length === 1 && args[0] === '--catalog') {
   process.stdout.write(`${JSON.stringify(catalog)}\n`);
-} else if (process.argv.length === 4 && process.argv[2] === '--seed') {
-  const seed = process.argv[3];
+} else if (
+  args.length === 2
+  && args[0] === '--seed'
+  && args[1].length > 0
+  && !args[1].startsWith('--')
+) {
+  const seed = args[1];
   const hash = createHash('sha256').update(seed, 'utf8').digest();
   const entry = catalog[hash.readUInt32BE(0) % 6];
   process.stdout.write(`${JSON.stringify({ ...entry, seed })}\n`);
+} else if (args.length === 0) {
+  const entry = catalog[randomInt(catalog.length)];
+  process.stdout.write(`${JSON.stringify({ ...entry, seed: null })}\n`);
+} else {
+  process.stderr.write('[E_USAGE] 引数は指定しないか、--catalog または --seed <空でなく--で始まらない文字列> を指定してください。\n');
+  process.exitCode = 2;
 }

