diff --git a/examples/omikuji/src/cli/main.mjs b/examples/omikuji/src/cli/main.mjs
index 1ac0fc8cce93456f94eeb16863a5168f61c5d5ac..bd0ccc191ee70ad58d019c6630c4426ff484c5d6
--- a/examples/omikuji/src/cli/main.mjs
+++ b/examples/omikuji/src/cli/main.mjs
@@ -1,3 +1,5 @@
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
 import { parseArguments } from './args.mjs';
 
 const help = `使い方:
@@ -16,13 +18,55 @@
 --seed=value 形式や位置引数には対応していません。
 `;
 
-try {
-  const options = parseArguments(process.argv.slice(2));
+function callJson(entry, args, input) {
+  const result = spawnSync(
+    process.execPath,
+    [fileURLToPath(new URL(entry, import.meta.url)), ...args],
+    {
+      cwd: process.cwd(),
+      env: process.env,
+      encoding: 'utf8',
+      input,
+    },
+  );
+  if (result.error || result.status !== 0) {
+    throw new Error('子プロセスの処理が成功しませんでした。');
+  }
+  return JSON.parse(result.stdout);
+}
+
+function main() {
+  let options;
+  try {
+    options = parseArguments(process.argv.slice(2));
+  } catch (error) {
+    process.stderr.write(`[E_USAGE] ${error.message}\n`);
+    process.exitCode = 2;
+    return;
+  }
+
   if (options.help) {
     process.stdout.write(help);
+    return;
+  }
+  // C2ではseed付き抽選だけを接続する。
+  if (options.seed === null) {
+    return;
+  }
+
+  try {
+    const draw = callJson('../fortune/main.mjs', ['--seed', options.seed]);
+    const drawJson = `${JSON.stringify(draw)}\n`;
+    callJson('../history/main.mjs', ['append'], drawJson);
+    process.stdout.write(
+      options.json
+        ? drawJson
+        : `運勢: ${draw.fortune}\nひとこと: ${draw.advice}\n`,
+    );
+  } catch {
+    process.stderr.write('[E_DEPENDENCY] 抽選または保存の成功応答を確認できませんでした。\n');
+    process.exitCode = 1;
   }
-  // C1は入力検証とhelpまで。正常な抽選・履歴処理の接続は後続のマスで行う。
-} catch (error) {
-  process.stderr.write(`[E_USAGE] ${error.message}\n`);
-  process.exitCode = 2;
 }
+
+main();

