オプション:
  --seed <文字列>  指定した文字列で抽選結果を再現します。
  --json           結果をJSONで表示します。
  --history        保存した履歴を表示します。--seed とは併用できません。
  --help           この使い方を表示します。単独で指定してください。

各オプションの順番は自由ですが、重複はできません。
seedは空文字や -- で始まる文字列を指定できません。
--seed=value 形式や位置引数には対応していません。
`;

function callJson(entry, args, input) {
  const result = spawnSync(
    process.execPath,
    [fileURLToPath(new URL(entry, import.meta.url)), ...args],
    {
      cwd: process.cwd(),
      env: process.env,
      encoding: 'utf8',
      input,
    },
  );
  if (result.error || result.status !== 0) {
    throw new Error('子プロセスの処理が成功しませんでした。');
  }
  return JSON.parse(result.stdout);
}

function main() {
  let options;
  try {
    options = parseArguments(process.argv.slice(2));
  } catch (error) {
    process.stderr.write(`[E_USAGE] ${error.message}\n`);
    process.exitCode = 2;
    return;
  }

  if (options.help) {
    process.stdout.write(help);
    return;
  }
  // C2ではseed付き抽選だけを接続する。
  if (options.seed === null) {
    return;
  }

  try {
    const draw = callJson('../fortune/main.mjs', ['--seed', options.seed]);
    const drawJson = `${JSON.stringify(draw)}\n`;
    callJson('../history/main.mjs', ['append'], drawJson);
    process.stdout.write(
      options.json
        ? drawJson
        : `運勢: ${draw.fortune}\nひとこと: ${draw.advice}\n`,
    );
  } catch {
    process.stderr.write('[E_DEPENDENCY] 抽選または保存の成功応答を確認できませんでした。\n');
    process.exitCode = 1;
  }
}

main();

