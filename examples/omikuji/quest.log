+      "kind": "agent",
+      "agent": "codex",
+      "job": "scribe",
+      "color": "blue",
+      "module": "JSON Linesの履歴追記・一覧・保全",
+      "territory": ["src/history/**"],
+      "path": ["H1", "H2", "G1", "HC", "H3", "GOAL"]
+    },
+    {
+      "id": "cli",
+      "name": "伝令",
+      "kind": "agent",
+      "agent": "codex",
+      "job": "herald",
+      "color": "orange",
+      "module": "引数解釈・利用者向け表示・抽選と履歴の接続",
+      "territory": ["src/cli/**"],
+      "path": ["C1", "C2", "G1", "CC", "C3", "GOAL"]
+    }
+  ],
+  "nodes": {
+    "F1": {
+      "type": "task",
+      "title": "六つの運勢と助言をそろえる",
+      "detail": "占い師はCONTRACTS.md §1〜3を読み、src/fortune/** の中にカタログの入口を作る。判定は node src/fortune/main.mjs --catalog を別プロセスで実行する。stdoutは大吉・中吉・小吉・吉・末吉・凶の順の6件の {fortune,advice} 配列と末尾LFだけ、stderrは空、終了0とする。各助言は日本語を含む1〜120文字の一行で、再起動しても変わらないこと。判定は一時ディレクトリで実行し、履歴が作られないことも確認する。助言の文言は担当が決める。ほかの担当のファイルは不要。抽選機能はこのマスでは作らない。",
+      "check": {
