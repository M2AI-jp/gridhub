+{
+  "masume": 1,
+  "quest": {
+    "id": "OMK",
+    "title": "おみくじを引いて記録する",
+    "pitch": "6種類の運勢と助言をCLIで引き、seedで再現し、JSONと履歴で振り返る",
+    "goal": "GOAL"
+  },
+  "characters": [
+    {
+      "id": "fortune",
+      "name": "占い師",
+      "kind": "agent",
+      "agent": "codex",
