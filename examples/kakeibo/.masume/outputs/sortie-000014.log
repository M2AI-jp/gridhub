index 0000000000000000000000000000000000000000..6eee3b41b1b41be09b399916deffa52686eaa570
--- /dev/null
+++ b/examples/kakeibo/src/tally/cli.mjs
@@ -0,0 +1,45 @@
+import { readFileSync } from 'node:fs';
+
+function summarizeMonth(expenses, month) {
+  let count = 0;
+  let total = 0;
+  const categories = new Map();
+
+  for (const expense of expenses) {
+    if (expense.date.slice(0, 7) !== month) continue;
+
+    count += 1;
+    total += expense.amount;
+
+    const subtotal = categories.get(expense.category) ?? {
+      category: expense.category,
+      count: 0,
+      total: 0,
+    };
+    subtotal.count += 1;
+    subtotal.total += expense.amount;
+    categories.set(expense.category, subtotal);
+  }
+
+  const byCategory = [...categories.keys()]
+    .sort()
+    .map((category) => categories.get(category));
+
+  return { month, currency: 'JPY', count, total, byCategory };
+}
+
+const args = process.argv.slice(2);
+
+if (args.length !== 2 || args[0] !== 'month') {
+  process.stderr.write('[E_USAGE] month YYYY-MM を指定してください。\n');
+  process.exitCode = 2;
+} else {
+  try {
+    const { expenses } = JSON.parse(readFileSync(0, 'utf8'));
+    const result = summarizeMonth(expenses, args[1]);
+    process.stdout.write(`${JSON.stringify(result)}\n`);
+  } catch {
+    process.stderr.write('[E_INPUT] 支出のJSONを読み取れません。\n');
+    process.exitCode = 2;
+  }
+}

