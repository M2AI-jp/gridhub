import { spawnSync } from 'node:child_process';
import { accessSync, constants, statSync } from 'node:fs';
import { isAbsolute } from 'node:path';
import { fileURLToPath } from 'node:url';
import { CliError } from './arguments.mjs';

function backendError(message) {
  return new CliError('E_BACKEND', message, 1);
}

export function callStore(request) {
  const storePath = process.env.KAKEIBO_STORE_CLI
    ?? fileURLToPath(new URL('../store/cli.mjs', import.meta.url));

  try {
    if (!isAbsolute(storePath) || !storePath.endsWith('.mjs') || !statSync(storePath).isFile()) {
      throw backendError('保存バックエンドを起動できませんでした。');
    }
    accessSync(storePath, constants.R_OK);
  } catch {
    throw backendError('保存バックエンドを起動できませんでした。');
  }

  const result = spawnSync(process.execPath, [storePath, request.command], {
    encoding: 'utf8',
    input: request.command === 'add' ? JSON.stringify(request.expense) : '',
    env: process.env,
    shell: false,
    maxBuffer: Infinity,
  });

  if (result.error || result.signal || result.status === null) {
    throw backendError('保存バックエンドを実行できませんでした。');
  }

  if (result.status !== 0) {
    const errorLine = result.stderr.split(/\r?\n/u, 1)[0];
    if (!errorLine) {
      throw backendError('保存バックエンドからエラーの説明が返りませんでした。');
    }
    return { stdout: '', stderr: `${errorLine}\n`, exitCode: result.status };
  }

  let response;
  try {
    response = JSON.parse(result.stdout);
  } catch {
    throw backendError('保存バックエンドから正しいJSONが返りませんでした。');
  }
  if (response === null || typeof response !== 'object' || Array.isArray(response)) {
    throw backendError('保存バックエンドからJSONオブジェクトが返りませんでした。');
  }

  return { stdout: `${JSON.stringify(response)}\n`, stderr: '', exitCode: 0 };
}
