    for (const key of keys) {
      const marker = key.match(/SECRET[A-Za-z]+/)[0];
      for (const args of [['push', '--team', 'TOY', '--dir', dir], ['pull', '--team', 'NOTE', '--out', join(dir, 'o.map.json')]]) {
