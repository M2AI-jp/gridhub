exec
/bin/zsh -lc "sed -n '620,860p' tests/e2e/M6.test.mjs
sed -n '1,135p' tests/helpers3.mjs
sed -n '1,135p' tests/helpers.mjs
sed -n '1,110p' tests/helpers2.mjs" in /Users/amano/dev/masume
 succeeded in 0ms:
    row('NOTE-5', '   ', { project }),
