import { check } from '../engine/index.js';
import { gameRoot, parseArgs, printCheckResult, usage } from '../engine/cli.js';

export async function run(argv, ctx) {
  const command = parseArgs(argv, ctx, { 'no-boss': 'boolean' });
  const { args, options, actor } = command;
  if (args.length !== 1) usage('つかいかた: check <characterId|gateId> [--no-boss]');
  const root = gameRoot(command);
  let result;
  try {
    result = await check(root, args[0], { actor, boss: !options['no-boss'] });
  } catch (error) {
    if (!options.json && error.code === 'E_PARTY_INCOMPLETE') console.log(error.message);
    throw error;
  }
  if (options.json) console.log(JSON.stringify(result));
  else printCheckResult(root, result);
  return result.exitCode;
}
import { writeNote } from '../engine/game.js';
import { gameRoot, parseArgs, usage } from '../engine/cli.js';

export async function run(argv, ctx) {
  const command = parseArgs(argv, ctx);
  const { args, options, actor } = command;
  if (args.length < 2) usage('つかいかた: note <characterId> <text…>');
  const event = writeNote(gameRoot(command), args[0], args.slice(1).join(' '), { actor });
  if (options.json) console.log(JSON.stringify(event));
  else console.log(`${args[0]} の日誌を記録しました（seq ${event.seq}）`);
  return 0;
}
import { inspectLog } from './store.js';
import { sortieStatus } from './sortie.js';
import { isSealed, nodeXp, replay } from './state.js';

function nodeState(node, progress, members, characters) {
  if (progress.cleared) return 'cleared';
  if (node.type !== 'gate') {
    if (progress.stale) return 'stale';
    if (members.some((character) => characters[character].at === node.id)) return 'current';
  } else {
    const waiting = members.filter((character) => characters[character].at === node.id
      && characters[character].status === 'waiting').length;
    if (waiting === members.length && waiting > 0) return 'ready';
    if (waiting > 0) return 'waiting';
  }
  if (members.some((id) => {
    const character = characters[id];
    const distance = character.path.indexOf(node.id) - character.pos;
    return distance > 0 && distance <= character.vision;
  })) return 'open';
  return 'fog';
}

function logEntry(event, map) {
  const data = event.data ?? {};
  const character = data.character ?? null;
  const node = data.gate ?? data.node ?? data.node_before ?? null;
  const name = map?.characters.find(({ id }) => id === character)?.name ?? character;
