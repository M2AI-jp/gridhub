import { readMap } from './store.js';

export const nodeXp = (node) => node.xp ?? (node.type === 'camp' ? 0 : node.type === 'gate' ? 3 : 1);
export const sealFiles = (node) => node.check?.kind === 'cmd' ? [...new Set(node.check.seal ?? [])] : [];

export function gateMembers(state, gate) {
  return state.map.characters.filter(({ path }) => path.includes(gate)).map(({ id }) => id);
}

export function gateParty(state, gate) {
  const members = state.map.nodes[gate]?.type === 'gate' ? gateMembers(state, gate) : [];
  const waiting = members.filter((id) => {
    const character = state.characters[id];
    const path = state.map.characters.find((entry) => entry.id === id).path;
    return character.status === 'waiting' && path[character.pos] === gate;
  });
  const missing = members.filter((id) => !waiting.includes(id));
  return { members, waiting, missing, ready: members.length > 0 && missing.length === 0 };
}

export function readyGate(state, characterId) {
  const character = state.characters[characterId];
  if (!character || character.status !== 'waiting') return null;
  const path = state.map.characters.find(({ id }) => id === characterId).path;
  const gate = path[character.pos];
  return gateParty(state, gate).ready ? gate : null;
}

export function isSealed(node, files) {
  const paths = sealFiles(node);
  return paths.length === 0 || (files !== null && files !== undefined
    && Object.keys(files).length === paths.length && paths.every((path) => Object.hasOwn(files, path)));
}

function arrive(state, character, seq) {
  const path = state.map.characters.find(({ id }) => id === character.id).path;
  while (state.map.nodes[path[character.pos]]?.type === 'camp') {
    const node = state.nodes[path[character.pos]];
    node.cleared = true;
    node.stale = false;
    node.lastSeq = seq;
    character.checkpoint = character.pos++;
  }
  character.status = character.pos >= path.length ? 'done'
    : state.map.nodes[path[character.pos]].type === 'gate' ? 'waiting' : 'working';
}

function initialState(map, version, { arriveNow = true } = {}) {
  const state = {
    map,
    version,
    revision: 0,
    characters: Object.create(null),
    nodes: Object.create(null),
  };
  for (const id of Object.keys(map.nodes)) {
    state.nodes[id] = {
      cleared: false, stale: false, files: null, sealedSeq: null, brokenSeq: null,
      clears: 0, fails: 0, lastSeq: null,
    };
  }
  for (const { id } of map.characters) {
    const character = {
      id, pos: 0, level: 1, xp: 0, checkpoint: -1, status: 'working',
      clears: 0, fails: 0, epoch: 0, lastNote: null,
    };
    state.characters[id] = character;
    if (arriveNow) arrive(state, character, 0);
  }
  return state;
}

function amendState(state, map, version, seq) {
  const next = initialState(map, version, { arriveNow: false });
  next.revision = seq;
  for (const id of Object.keys(next.nodes)) {
    if (state.nodes[id]) next.nodes[id] = state.nodes[id];
  }
  for (const id of Object.keys(next.characters)) {
    if (state.characters[id]) {
      next.characters[id] = state.characters[id];
      next.characters[id].epoch++;
    }
    arrive(next, next.characters[id], seq);
  }
  return next;
}

function gainXp(character, xp) {
  character.xp += xp;
  while (character.level < 9 && character.xp >= character.level + 1) {
    character.xp -= character.level + 1;
    character.level++;
  }
}

function passTask(state, character, id, seq) {
  const node = state.nodes[id];
  if (!node.stale) gainXp(character, nodeXp(state.map.nodes[id]));
  node.cleared = true;
  node.stale = false;
  node.clears++;
  node.lastSeq = seq;
  character.clears++;
  character.pos++;
  character.epoch++;
  arrive(state, character, seq);
}

function rollbackCharacter(state, character, position, seq) {
  const path = state.map.characters.find(({ id }) => id === character.id).path;
  for (let i = position; i < character.pos; i++) {
    const node = state.nodes[path[i]];
    if (node.cleared) {
      node.cleared = false;
      node.stale = true;
      node.lastSeq = seq;
    }
  }
  character.level = Math.max(1, character.level - 1);
  character.xp = 0;
  character.fails++;
  character.pos = position;
  character.epoch++;
  arrive(state, character, seq);
}

function failTask(state, character, failed, seq) {
  const path = state.map.characters.find(({ id }) => id === character.id).path;
  const rollback = state.map.nodes[failed].rollback_to ?? '@camp';
  const target = rollback === '@camp' ? character.checkpoint + 1
    : path.indexOf(rollback === '@here' ? failed : rollback);
  state.nodes[failed].fails++;
  state.nodes[failed].lastSeq = seq;
  rollbackCharacter(state, character, Math.max(character.checkpoint + 1, target), seq);
}

function passGate(state, gate, members, seq) {
  const node = state.nodes[gate];
  node.cleared = true;
  node.stale = false;
  node.clears++;
  node.lastSeq = seq;
  for (const id of members) {
    const character = state.characters[id];
    gainXp(character, nodeXp(state.map.nodes[gate]));
    character.clears++;
    character.checkpoint = character.pos++;
    character.epoch++;
    arrive(state, character, seq);
  }
}

// 記録された事実だけを適用する。判定コマンドやファイルの現在の内容には依存しない。
export function reduceEvent(state, event) {
  const { type, data, seq } = event;
  const character = state.characters[data?.character];
  const node = state.nodes[data?.node];
  switch (type) {
    case 'sealed':
      if (node) {
        node.files = { ...data.files };
        node.sealedSeq = seq;
        node.lastSeq = seq;
      }
      break;
    case 'seal_broken':
      if (node) {
        node.brokenSeq = seq;
        node.lastSeq = seq;
      }
      break;
    case 'check_passed':
    case 'check_failed':
      if (character && node) {
        for (const id of [data.node, ...(data.ran ?? [])]) {
          if (state.nodes[id]) state.nodes[id].lastSeq = seq;
        }
        if (type === 'check_passed') passTask(state, character, data.node, seq);
        else failTask(state, character, data.failed, seq);
      }
      break;
    case 'stamped':
      if (character && node) passTask(state, character, data.node, seq);
      break;
    case 'gate_cleared':
    case 'gate_failed': {
      const gate = state.nodes[data.gate];
      if (!gate || state.map.nodes[data.gate].type !== 'gate') break;
      const members = gateMembers(state, data.gate);
      if (type === 'gate_cleared') {
        passGate(state, data.gate, members, seq);
      } else {
        const blamed = members.filter((id) => (data.blamed ?? []).includes(id));
        gate.fails++;
        gate.lastSeq = seq;
        for (const id of blamed.length ? blamed : members) {
          const member = state.characters[id];
          rollbackCharacter(state, member, member.checkpoint + 1, seq);
        }
      }
      break;
    }
    case 'note':
      if (character) {
        character.lastNote = data.text;
        character.epoch++;
      }
      break;
    // 知らないイベントは、前方互換のため無視する。
  }
  return state;
}

export function replay(root, events) {
  const genesis = events[0];
  if (!genesis || genesis.type !== 'genesis') return null;
  let state = initialState(readMap(root, genesis.data.map_file), genesis.data.version);
  // ロードの参照先だけを保存する。過去の loaded を含む時点も、再帰せず復元できる。
  const targets = new Set(events.filter(({ type }) => type === 'loaded').map(({ data }) => data.to_seq));
  const snapshots = new Map();
  for (const event of events) {
    if (event.type === 'amended') {
      state = amendState(state, readMap(root, event.data.map_file), event.data.version, event.seq);
    } else if (event.type === 'loaded') {
      state = structuredClone(snapshots.get(event.data.to_seq));
      // epoch まで過去に戻っても、実行中の判定は新しい盤面へ追記できない。
      state.revision = event.seq;
    } else {
      reduceEvent(state, event);
    }
    if (targets.has(event.seq)) snapshots.set(event.seq, structuredClone(state));
  }
  return state;
}
// E1「冒険の書をひらく」— 書記の最初のマス。SAVE_FORMAT.md と CONTRACTS §2/§3 の判定。
import test from 'node:test';
import assert from 'node:assert/strict';
import { readFileSync, writeFileSync, appendFileSync, existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { tmp, masume, masumeJson, masumeAsync, readLog, setupToy, toyMap, eventHash, jumonOf, sha256, canonical } from '../helpers.mjs';

const ZERO = '0'.repeat(64);

function writeMap(dir, name, map) {
  writeFileSync(join(dir, name), JSON.stringify(map, null, 2));
  return name;
}

test('validate: 正しい地図は通る', () => {
  const dir = tmp();
  setupToy(dir);
  const r = masume(['validate', 'toy.map.json'], { cwd: dir });
  assert.equal(r.code, 0, r.all);
  const j = masumeJson(['validate', 'toy.map.json'], { cwd: dir });
  assert.equal(j.code, 0, j.all);
  assert.equal(j.data.ok, true);
  assert.deepEqual(j.data.errors, []);
});

test('validate: 壊れた地図はエラーコードで指摘される', () => {
  const dir = tmp();
  const cases = [
    ['E_UNKNOWN_NODE', (m) => m.characters[0].path.splice(1, 0, 'NOPE')],
    ['E_SHARED_TASK', (m) => m.characters[1].path.splice(0, 0, 'A1')],
    ['E_GATE_MEMBERS', (m) => { m.nodes.G9 = { type: 'gate', title: 'ひとりのゲート', check: { kind: 'cmd', run: 'true' } }; m.characters[0].path.splice(1, 0, 'G9'); }],
    ['E_ORPHAN', (m) => { m.nodes.Z9 = { type: 'task', title: '迷子', check: { kind: 'cmd', run: 'true' } }; }],
    ['E_CYCLE', (m) => {
      m.nodes.G2 = { type: 'gate', title: '二つ目', check: { kind: 'cmd', run: 'true' } };
      m.characters[0].path.splice(m.characters[0].path.indexOf('G1') + 1, 0, 'G2');
      m.characters[1].path.splice(m.characters[1].path.indexOf('G1'), 0, 'G2');
    }],
    ['E_ROLLBACK', (m) => { m.nodes.A1.rollback_to = 'A4'; }],
    ['E_CHECK', (m) => { delete m.nodes.A2.check; }],
    ['E_CHECK', (m) => { m.nodes.H1.check.by = 'a'; }],
    ['E_GOAL', (m) => { m.quest.goal = 'A1'; }],
    ['E_DUP_IN_PATH', (m) => { m.characters[0].path.splice(2, 0, 'A1'); }],
    ['E_DUP_CHAR', (m) => { m.characters.push({ ...m.characters[1], path: ['FIN'] }); }],
    ['E_FORMAT', (m) => { m.masume = 2; }],
    ['E_ID', (m) => { m.characters[0].id = 'Bad Id'; }],
  ];
  for (const [code, mutate] of cases) {
    const m = toyMap();
    mutate(m);
    writeMap(dir, 'bad.map.json', m);
    const r = masume(['validate', 'bad.map.json'], { cwd: dir });
    assert.equal(r.code, 1, `${code} のとき終了コード1: ${r.all}`);
    assert.match(r.all, new RegExp(code), `${code} が出力に含まれる: ${r.all}`);
    const j = masumeJson(['validate', 'bad.map.json'], { cwd: dir });
    assert.equal(j.data.ok, false);
    assert.ok(j.data.errors.some((e) => e.code === code), `${code} が errors に含まれる: ${JSON.stringify(j.data.errors)}`);
  }
});

test('new: 冒険の書が生まれ、存在する判定ファイルは自動で封印される', () => {
  const dir = tmp();
  setupToy(dir);
  const r = masume(['new', 'toy.map.json'], { cwd: dir });
  assert.equal(r.code, 0, r.all);
  assert.match(r.out, /ふっかつのじゅもん/);
  assert.ok(existsSync(join(dir, '.masume', 'log.jsonl')));
  assert.ok(existsSync(join(dir, '.masume', 'maps', '0001.json')));

  const log = readLog(dir);
  assert.equal(log[0].seq, 0);
  assert.equal(log[0].type, 'genesis');
  assert.equal(log[0].prev, ZERO);
  assert.equal(log[0].data.masume, 1);
  assert.equal(log[0].data.quest_id, 'TOY');
  assert.equal(log[0].data.map_file, 'maps/0001.json');
  const map = JSON.parse(readFileSync(join(dir, '.masume', 'maps', '0001.json'), 'utf8'));
  assert.equal(log[0].data.map_hash, sha256(canonical(map)));

  // 鎖が正しい
  log.forEach((e, i) => {
    assert.equal(e.seq, i);
    assert.equal(e.hash, eventHash(e), `seq ${i} の hash`);
    if (i > 0) assert.equal(e.prev, log[i - 1].hash, `seq ${i} の prev`);
  });

  // checks/flag.mjs を使うマスは封印済み、checks/b3.mjs（存在しない）のB3は未封印
  const sealed = log.filter((e) => e.type === 'sealed');
  const sealedNodes = sealed.map((e) => e.data.node).sort();
  assert.deepEqual(sealedNodes, ['A1', 'A2', 'A3', 'A4', 'B1', 'B2', 'FIN', 'G1']);
  const flagHash = sha256(readFileSync(join(dir, 'checks', 'flag.mjs')));
  for (const e of sealed) assert.deepEqual(e.data.files, { 'checks/flag.mjs': flagHash });

  // 二重に new はできない
  const again = masume(['new', 'toy.map.json'], { cwd: dir });
  assert.equal(again.code, 2, again.all);
  assert.match(again.all, /E_EXISTS/);
  // 壊れた地図では始まらない
  const dir2 = tmp();
  const bad = toyMap();
  bad.quest.goal = 'NOPE';
  writeMap(dir2, 'bad.map.json', bad);
  const r2 = masume(['new', 'bad.map.json'], { cwd: dir2 });
  assert.equal(r2.code, 1, r2.all);
  assert.ok(!existsSync(join(dir2, '.masume', 'log.jsonl')));
});

test('jumon / verify: ふっかつのじゅもんで状態を指せる', () => {
  const dir = tmp();
  setupToy(dir);
  masume(['new', 'toy.map.json'], { cwd: dir });
  const log = readLog(dir);
  const head = log[log.length - 1];
  const expected = jumonOf(head.hash);

  const j = masume(['jumon'], { cwd: dir });
  assert.equal(j.code, 0, j.all);
  assert.equal(j.out.trim().split('\n').pop().trim(), expected);
  assert.match(expected, /^[ぁ-ん]{3}( [ぁ-ん]{3}){3}$/);
  const jj = masumeJson(['jumon'], { cwd: dir });
  assert.deepEqual(jj.data, { seq: head.seq, hash: head.hash, jumon: expected });

  const v = masume(['verify'], { cwd: dir });
  assert.equal(v.code, 0, v.all);
  assert.match(v.out, /冒険の書は正常です/);
  const vj = masumeJson(['verify'], { cwd: dir });
  assert.equal(vj.data.ok, true);
  assert.deepEqual(vj.data.head, { seq: head.seq, hash: head.hash, jumon: expected });

  // 過去のじゅもんでも見つかる（空白なし・カタカナでもよい）
  const past = jumonOf(log[0].hash);
  const katakana = past.replace(/\s/g, '').replace(/[ぁ-ゖ]/g, (c) => String.fromCharCode(c.charCodeAt(0) + 0x60));
  const f = masumeJson(['verify', '--jumon', katakana], { cwd: dir });
  assert.equal(f.code, 0, f.all);
  assert.deepEqual(f.data.found, { seq: 0 });
  const nf = masume(['verify', '--jumon', 'ぼぼぼ ぼぼぼ ぼぼぼ ぼぼぼ'], { cwd: dir });
  assert.equal(nf.code, 1, nf.all);
});

test('verify / repair: 改ざんは「呪い」として見つかり、修復できる', () => {
  const dir = tmp();
  setupToy(dir);
  masume(['new', 'toy.map.json'], { cwd: dir });
  for (let i = 0; i < 3; i++) assert.equal(masume(['note', 'a', `日誌${i}`, '--as', 'a'], { cwd: dir }).code, 0);
  const file = join(dir, '.masume', 'log.jsonl');
  const lines = readFileSync(file, 'utf8').split('\n').filter(Boolean);
  const target = lines.length - 2; // 最後から2つ目の日誌を書き換える
  const e = JSON.parse(lines[target]);
  e.data.text = '書き換えた';
  lines[target] = JSON.stringify(e);
  writeFileSync(file, lines.join('\n') + '\n');

  const v = masume(['verify'], { cwd: dir });
  assert.equal(v.code, 3, v.all);
  assert.match(v.all, /呪われています/);
  assert.match(v.all, new RegExp(`seq ${target}`));
  const vj = masumeJson(['verify'], { cwd: dir });
  assert.equal(vj.data.ok, false);
  assert.equal(vj.data.errors[0].seq, target);
  assert.equal(vj.data.errors[0].code, 'E_HASH');

  // 呪われた冒険の書では他のコマンドは動かない
  const n = masume(['note', 'a', 'もう一行', '--as', 'a'], { cwd: dir });
  assert.equal(n.code, 3, n.all);
  assert.match(n.all, /E_CURSED/);

  const rp = masume(['repair'], { cwd: dir });
  assert.equal(rp.code, 0, rp.all);
  assert.ok(readdirSync(join(dir, '.masume')).some((f) => /^log\.corrupt-.*\.jsonl$/.test(f)), '退避ファイルがある');
  assert.equal(masume(['verify'], { cwd: dir }).code, 0);
  const after = readLog(dir);
  assert.equal(after.length, target);
  assert.equal(masume(['note', 'a', '再開', '--as', 'a'], { cwd: dir }).code, 0);
  assert.equal(masume(['verify'], { cwd: dir }).code, 0);
});

test('verify / repair: 書きかけで途切れた行も見つかる', () => {
